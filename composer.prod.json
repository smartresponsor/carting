{
  "name": "carting/cart",
  "description": "Smart Responsor Carting component for mutable cart and checkout handoff responsibility.",
  "type": "symfony-bundle",
  "license": "proprietary",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "vcs",
      "url": "git@github.com:smartresponsor/interfacing.git",
      "no-api": true
    },
    {
      "type": "vcs",
      "url": "git@github.com:smartresponsor/cruding.git",
      "no-api": true
    },
    {
      "type": "vcs",
      "url": "git@github.com:smartresponsor/viewing.git",
      "no-api": true
    },
    {
      "type": "vcs",
      "url": "git@github.com:smartresponsor/objecting.git",
      "no-api": true
    }
  ],
  "require": {
    "php": "^8.4",
    "cruding/crud": "dev-master",
    "viewing/view": "dev-master",
    "interfacing/interface": "dev-master",
    "objecting/object": "dev-master",
    "easycorp/easyadmin-bundle": "^5.0",
    "symfony/framework-bundle": "^8.1",
    "symfony/console": "^8.1",
    "symfony/config": "^8.1",
    "symfony/dependency-injection": "^8.1",
    "symfony/http-kernel": "^8.1",
    "symfony/routing": "^8.1",
    "symfony/form": "^8.1",
    "symfony/validator": "^8.1",
    "doctrine/orm": "^3.0",
    "doctrine/doctrine-bundle": "^3.0",
    "doctrine/doctrine-migrations-bundle": "^4.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "phpstan/phpstan": "^2.0",
    "friendsofphp/php-cs-fixer": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "App\\Carting\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Carting\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit",
    "stan": "@php vendor/bin/phpstan analyse src tests --no-progress",
    "analyse": "@stan",
    "lint": "@php -l src/CartingBundle.php",
    "cs:check": "@php vendor/bin/php-cs-fixer fix --dry-run --diff",
    "cs:fix": "@php vendor/bin/php-cs-fixer fix",
    "schema:validate": "@php bin/console doctrine:schema:validate --env=test",
    "schema:parity": [
      "@schema:validate",
      "@php bin/console doctrine:migrations:up-to-date --env=test"
    ],
    "qa": [
      "@cs:check",
      "@test",
      "@stan"
    ]
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "8.1.*"
    }
  }
}
