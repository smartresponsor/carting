{
  "name": "carting/cart",
  "description": "Smart Responsor Carting component for mutable cart and checkout handoff responsibility.",
  "type": "symfony-bundle",
  "license": "proprietary",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "path",
      "url": "../Interfacing",
      "options": {
        "symlink": true
      }
    }
  ],
  "require": {
    "php": "^8.4",
    "interfacing/interface": "*@dev",
    "symfony/config": "^8.1",
    "symfony/dependency-injection": "^8.1",
    "symfony/http-kernel": "^8.1",
    "symfony/routing": "^8.1",
    "symfony/form": "^8.1",
    "symfony/validator": "^8.1",
    "doctrine/orm": "^3.0",
    "doctrine/doctrine-bundle": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "phpstan/phpstan": "^2.0",
    "friendsofphp/php-cs-fixer": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "App\\Carting\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Carting\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit",
    "stan": "@php vendor/bin/phpstan analyse src tests --no-progress",
    "analyse": "@stan",
    "lint": "@php -l src/CartingBundle.php",
    "qa": [
      "@test",
      "@stan"
    ]
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "8.0.*"
    }
  }
}
