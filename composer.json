{
  "name": "carting/cart",
  "description": "Smart Responsor Carting component for mutable cart and checkout handoff responsibility.",
  "type": "symfony-bundle",
  "license": "proprietary",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "path",
      "url": "../Interfacing",
      "options": {
        "symlink": true,
        "versions": {
          "interfacing/interface": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Cruding",
      "options": {
        "symlink": true,
        "versions": {
          "cruding/crud": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Viewing",
      "options": {
        "symlink": true,
        "versions": {
          "viewing/view": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Objecting",
      "options": {
        "symlink": true,
        "versions": {
          "objecting/object": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Collectioning",
      "options": {
        "symlink": true,
        "versions": {
          "collectioning/collection": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Tabling",
      "options": {
        "symlink": true,
        "versions": {
          "tabling/table": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Gating",
      "options": {
        "symlink": true,
        "versions": {
          "gating/gate": "dev-master"
        }
      }
    }
  ],
  "require": {
    "php": "^8.4",
    "cruding/crud": "dev-master",
    "collectioning/collection": "dev-master",
    "tabling/table": "dev-master",
    "viewing/view": "dev-master",
    "interfacing/interface": "dev-master",
    "objecting/object": "dev-master",
    "easycorp/easyadmin-bundle": "^5.0",
    "symfony/framework-bundle": "^8.1",
    "symfony/console": "^8.1",
    "symfony/config": "^8.1",
    "symfony/dependency-injection": "^8.1",
    "symfony/http-kernel": "^8.1",
    "symfony/routing": "^8.1",
    "symfony/form": "^8.1",
    "symfony/validator": "^8.1",
    "doctrine/orm": "^3.0",
    "doctrine/doctrine-bundle": "^3.0",
    "doctrine/doctrine-migrations-bundle": "^4.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "phpstan/phpstan": "^2.0",
    "symfony/dotenv": "^8.1",
    "symfony/panther": "^2.4",
    "symfony/test-pack": "^1.2",
    "friendsofphp/php-cs-fixer": "^3.0",
    "gating/gate": "dev-master"
  },
  "autoload": {
    "psr-4": {
      "App\\Carting\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Carting\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit",
    "test:coverage": [
      "@php -r \"if (!is_dir('var/coverage')) { mkdir('var/coverage', 0777, true); }\"",
      "@php -d xdebug.mode=coverage vendor/bin/phpunit --path-coverage --coverage-text=var/coverage/summary.txt"
    ],
    "stan": "@php vendor/bin/phpstan analyse src tests migrations --no-progress",
    "analyse": "@stan",
    "validate:prod": "composer validate --strict --no-check-all composer.prod.json",
    "lint": "@php -l src/CartingBundle.php",
    "cs:check": "@php vendor/bin/php-cs-fixer fix --dry-run --diff",
    "cs:fix": "@php vendor/bin/php-cs-fixer fix",
    "schema:test:reset": [
      "@php bin/console doctrine:database:drop --env=test --force --if-exists",
      "@php bin/console doctrine:database:create --env=test --if-not-exists",
      "@php bin/console doctrine:migrations:migrate --env=test --no-interaction"
    ],
    "schema:validate": "@php bin/console doctrine:schema:validate --env=test",
    "schema:diff": "@php bin/console doctrine:schema:update --env=test --dump-sql",
    "schema:parity": [
      "@schema:test:reset",
      "@schema:validate",
      "@php bin/console doctrine:migrations:up-to-date --env=test"
    ],
    "gating:check": "php vendor/bin/gating check --target=. --profile=config/cart_gating_profile.yaml --rule-set=config/cart_gating_rules.yaml --policy-root=vendor/gating/gate/.gating --severity-config=vendor/gating/gate/.gating/config/severity.yaml",
    "qa": [
      "@cs:check",
      "@test",
      "@stan"
    ],
    "gate": "@php vendor/bin/gating check --target=.",
    "quality": [
      "@cs:check",
      "@stan",
      "@test",
      "@gate"
    ]
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "8.1.*"
    }
  }
}
