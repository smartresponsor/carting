{% set surface = surface|default({}) %}
{% set slots = surface.slots|default({}) %}

<section class="cart-data-fallback" data-surface-word="{{ surface.word|default('') }}" data-surface-view="{{ surface.view|default('') }}">
    <h1>{{ slots.title|default(surface.word|default('Data')) }}</h1>
    <pre>{{ slots|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
</section>
